# Razorpay TEST MODE credentials (never commit real secrets)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=replace_with_a_separate_webhook_secret

# Create these two monthly plans once in Razorpay Dashboard (Test Mode)
# Sadhu Seva: INR 128 / month
# Bhaktamandali Trustee: INR 1028 / month
RAZORPAY_PLAN_SADHU_SEVA=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_TRUSTEE=plan_xxxxxxxxxxxx

# Razorpay subscriptions require a finite billing count.
# 120 monthly cycles = 10 years (Razorpay maximum duration).
RAZORPAY_SUBSCRIPTION_CYCLES=120

# Supabase persistence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
SUPABASE_BACKEND_TOKEN=generate_a_long_random_secret_and_keep_it_server_side_only
